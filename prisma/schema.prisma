generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  CUSTOM
}

model CustomRole {
  id          Int      @id @default(autoincrement())
  name        String   @unique
  status      String   @default("Active")
  permissions String[]
  admins      Admin[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Admin {
  id           Int         @id @default(autoincrement())
  name         String
  email        String      @unique
  password     String
  role         Role        @default(ADMIN)
  status       String      @default("Active")
  customRoleId Int?
  customRole   CustomRole? @relation(fields: [customRoleId], references: [id])
  doorQrToken  String?     @unique
  isQrEnabled  Boolean     @default(true)
  createdAt    DateTime    @default(now())

  // Multi-tenant relations
  cows                 Cow[]
  reproductionRecords  ReproductionRecord[]
  foodPurchases        FoodPurchase[]
  cowFoodRecords       CowFoodRecord[]
  foodIntakes          FoodIntake[]
  milkRecords          MilkRecord[]
  cowSales             CowSale[]
  treatments           Treatment[]
  items                Item[]
  stockAdjustments     StockAdjustment[]
  orders               Order[]
  cowDeaths            CowDeath[]
  animalFeedingPlans   AnimalFeedingPlan[]
  milkAllocations      MilkAllocation[]
  customerMilkOrders   CustomerMilkOrder[]
  products             Product[]
  milkTrials           MilkTrial[]
  milkSubscriptions    MilkSubscription[]
  conversionRules      ConversionRule[]
  deliveryProfile      DeliveryBoyProfile?
  deliveryAssignments  DeliveryAssignment[]
  deliveryHistories     DeliveryHistory[]
  deliveryAvailability DeliveryAvailability[]
  userAlerts           UserAlert[]
  deliveryBoyLeaves    DeliveryBoyLeave[]     @relation("DeliveryBoyLeaves")
  approvedLeaves       DeliveryBoyLeave[]     @relation("AdminApprovedLeaves")
  deliveryRequests        MilkDeliveryRequest[]  @relation("CustomerDeliveryRequests")
  approvedDeliveryRequests MilkDeliveryRequest[] @relation("AdminApprovedRequests")
}

model ConversionRule {
  id            Int      @id @default(autoincrement())
  inputMaterial String   @default("Milk") // e.g. Milk, Curd, Cream
  inputQty      Float
  outputProduct String // e.g. Ghee, Paneer, Curd
  outputQty     Float
  outputUnit    String // e.g. L, KG
  isActive      Boolean  @default(true)
  adminId       Int?
  admin         Admin?   @relation(fields: [adminId], references: [id])
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Cow {
  id                  Int                  @id @default(autoincrement())
  tagNo               String
  name                String
  breed               String
  age                 Int
  gender              String
  status              String               @default("Active")
  animalType          String               @default("Cow")
  regNo               String?
  dob                 DateTime?
  purchaseDate        DateTime?
  purchaseFrom        String?
  purchaseAddress     String?
  mobileNo            String?
  purchasePrice       Float?
  governmentTagNo     String?
  fatherName          String?
  motherName          String?
  fatherFatherName    String?
  fatherMotherName    String?
  motherFatherName    String?
  motherMotherName    String?
  image               String?
  image2              String?
  isActiveForMilk     Boolean              @default(false)
  createdAt           DateTime             @default(now())
  milk                MilkRecord[]
  food                CowFoodRecord[]
  treatments          Treatment[]
  sales               CowSale[]
  deaths              CowDeath[]
  reproductionRecords ReproductionRecord[]
  feedingPlans        AnimalFeedingPlan[]
  foodIntakes         FoodIntake[]
  adminId             Int?
  admin               Admin?               @relation(fields: [adminId], references: [id])

  @@unique([adminId, tagNo])
}

model ReproductionRecord {
  id                   Int       @id @default(autoincrement())
  cowId                Int
  heatDate             DateTime?
  aiDate               DateTime?
  aiBullName           String?
  bullName             String?
  doctorName           String?
  doctorArrivingAt     DateTime?
  pregnancyCheckDate   DateTime?
  pregnancyStatus      String?
  deliveryDate         DateTime?
  calfName             String?
  remark               String?
  breedingStatus       String?
  lastBreedingDate     DateTime?
  serviceCount         Int?
  aiType               String?
  expectedNextHeatDate DateTime?
  pregnancyMonth       String?
  veterinaryRemarks    String?
  createdAt            DateTime  @default(now())
  cow                  Cow       @relation(fields: [cowId], references: [id], onDelete: Cascade)
  adminId              Int?
  admin                Admin?    @relation(fields: [adminId], references: [id])
}

model FoodPurchase {
  id          Int      @id @default(autoincrement())
  itemName    String
  quantityKg  Float
  price       Float
  supplier    String?
  purchasedAt DateTime @default(now())
  adminId     Int?
  admin       Admin?   @relation(fields: [adminId], references: [id])
}

model CowFoodRecord {
  id         Int      @id @default(autoincrement())
  cowId      Int
  foodType   String
  quantityKg Float
  fedAt      DateTime @default(now())
  cow        Cow      @relation(fields: [cowId], references: [id], onDelete: Cascade)
  adminId    Int?
  admin      Admin?   @relation(fields: [adminId], references: [id])
}

model FoodIntake {
  id              Int      @id @default(autoincrement())
  cowId           Int?
  foodItem        String?
  foodType        String
  morningIntake   Float?   @default(0)
  afternoonIntake Float?   @default(0)
  eveningIntake   Float?   @default(0)
  totalIntake     Float    @default(0)
  quantityKg      Float?
  notes           String?
  recordedAt      DateTime @default(now())
  cow             Cow?     @relation(fields: [cowId], references: [id], onDelete: Cascade)
  adminId         Int?
  admin           Admin?   @relation(fields: [adminId], references: [id])
}

model MilkRecord {
  id          Int      @id @default(autoincrement())
  cowId       Int
  morningMilk Float?
  eveningMilk Float?
  totalMilk   Float    @default(0)
  recordDate  DateTime @default(now())
  cow         Cow      @relation(fields: [cowId], references: [id], onDelete: Cascade)
  adminId     Int?
  admin       Admin?   @relation(fields: [adminId], references: [id])
}

model CowSale {
  id             Int      @id @default(autoincrement())
  cowId          Int
  buyer          String
  amount         Float
  soldAt         DateTime @default(now())
  paymentMethod  String   @default("Cash")
  paymentStatus  String   @default("Paid")
  amountReceived Float    @default(0)
  buyerPhone     String?
  buyerAddress   String?
  buyerCity      String?
  buyerState     String?
  buyerPincode   String?
  reason         String   @default("Other")
  otherReason    String?
  lastMilkProd   Float?
  lastFeedIntake Float?
  remark         String?
  cow            Cow      @relation(fields: [cowId], references: [id], onDelete: Cascade)
  adminId        Int?
  admin          Admin?   @relation(fields: [adminId], references: [id])
}

model Treatment {
  id             Int      @id @default(autoincrement())
  cowId          Int
  diagnosis      String
  medicine       String
  cost           Float
  treatedAt      DateTime @default(now())
  doctorName     String?
  remarks        String?
  milkDropSource Boolean  @default(false)
  previousMilk   Float?
  currentMilk    Float?
  dropPercentage Float?
  cow            Cow      @relation(fields: [cowId], references: [id], onDelete: Cascade)
  adminId        Int?
  admin          Admin?   @relation(fields: [adminId], references: [id])
}

model Item {
  id           Int               @id @default(autoincrement())
  name         String
  unit         String
  price        Float?
  currentStock Float             @default(0)
  minimumLevel Float?
  remarks      String?
  createdAt    DateTime          @default(now())
  adjustments  StockAdjustment[]
  adminId      Int?
  admin        Admin?            @relation(fields: [adminId], references: [id])
}

model StockAdjustment {
  id            Int      @id @default(autoincrement())
  itemId        Int
  type          String // "Add" or "Remove"
  previousStock Float
  adjustment    Float
  newStock      Float
  reason        String
  remarks       String?
  createdBy     String   @default("admin")
  createdAt     DateTime @default(now())
  item          Item     @relation(fields: [itemId], references: [id], onDelete: Cascade)
  adminId       Int?
  admin         Admin?   @relation(fields: [adminId], references: [id])
}

model Order {
  id            Int         @id @default(autoincrement())
  orderNumber   String      @unique
  vendorName    String
  location      String?
  purchaseDate  DateTime    @default(now())
  totalAmount   Float       @default(0)
  paymentStatus String      @default("Pending")
  remarks       String?
  createdAt     DateTime    @default(now())
  items         OrderItem[]
  adminId       Int?
  admin         Admin?      @relation(fields: [adminId], references: [id])
}

model OrderItem {
  id       Int    @id @default(autoincrement())
  orderId  Int
  itemName String
  quantity Float
  unit     String @default("Kg")
  price    Float
  order    Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

model CowDeath {
  id             Int       @id @default(autoincrement())
  cowId          Int
  reason         String
  deathAt        DateTime  @default(now())
  notes          String?
  disposalMethod String?
  disposalDate   DateTime?
  disposalCost   Float?
  cow            Cow       @relation(fields: [cowId], references: [id], onDelete: Cascade)
  adminId        Int?
  admin          Admin?    @relation(fields: [adminId], references: [id])
}

model AnimalFeedingPlan {
  id                 Int      @id @default(autoincrement())
  cowId              Int
  planName           String
  startDate          DateTime
  endDate            DateTime
  feedName           String
  feedType           String
  quantity           Float
  unit               String
  feedingTime        String
  frequency          String
  instructions       String?
  remarks            String?
  status             String   @default("Active")
  prevDayMilkProd    Float?
  recommendedFeedQty Float?
  createdAt          DateTime @default(now())
  basedOnMilk        Float?
  entryType          String?
  milkEntryId        Int?
  cow                Cow      @relation(fields: [cowId], references: [id], onDelete: Cascade)
  adminId            Int?
  admin              Admin?   @relation(fields: [adminId], references: [id])
}

model MilkAllocation {
  id           Int      @id @default(autoincrement())
  adminId      Int
  staffId      Int
  date         DateTime
  allocatedQty Float
  status       String   @default("Pending")
  createdAt    DateTime @default(now())
  admin        Admin    @relation(fields: [adminId], references: [id])
}

model StaffMilkReport {
  id           Int      @id @default(autoincrement())
  staffId      Int
  reportDate   DateTime
  receivedQty  Float
  totalUsedQty Float    @default(0)
  remainingQty Float    @default(0)
  usageDetails Json?
  status       String   @default("PENDING_ADMIN_REVIEW")
  adminRemarks String?
  createdAt    DateTime @default(now())
}

model CustomerMilkOrder {
  id               Int                @id @default(autoincrement())
  userId           Int?
  adminId          Int?
  customerName     String?
  phone            String
  address          String
  milkType         String
  quantity         Float
  deliveryDate     DateTime
  originalDate     DateTime?
  proposedDate     DateTime?
  deliveryBoyName  String?
  deliveryBoyPhone String?
  status           String             @default("PENDING_ADMIN")
  notes            String?
  createdAt        DateTime           @default(now())
  admin            Admin?             @relation(fields: [adminId], references: [id])
  history          OrderHistoryLine[]
  productId        Int?
  product          Product?           @relation(fields: [productId], references: [id])
}

model OrderHistoryLine {
  id            Int               @id @default(autoincrement())
  orderId       Int
  status        String
  actor         String
  actorName     String?
  actionDetails String?
  createdAt     DateTime          @default(now())
  order         CustomerMilkOrder @relation(fields: [orderId], references: [id])
}

// --- Milk Delivery System Models ---

model Product {
  id            Int                 @id @default(autoincrement())
  adminId       Int
  name          String
  image         String?
  price         Float
  description   String?
  size          String?
  unit          String?
  isActive      Boolean             @default(true)
  createdAt     DateTime            @default(now())
  admin         Admin               @relation(fields: [adminId], references: [id])
  orders        CustomerMilkOrder[]
  trials        MilkTrial[]
  subscriptions MilkSubscription[]
}

model MilkTrial {
  id             Int       @id @default(autoincrement())
  userId         Int?
  adminId        Int
  customerName   String
  phone          String
  address        String
  pincode        String?
  milkType       String
  dailyQuantity  Float
  startDate      DateTime?
  endDate        DateTime?
  status         String    @default("PENDING_ADMIN") // PENDING_ADMIN, ACTIVE, REJECTED, COMPLETED
  notes          String?
  createdAt      DateTime  @default(now())
  admin          Admin     @relation(fields: [adminId], references: [id])
  deliveryBoyId  Int?
  deliveryStatus String?   @default("Pending") // Pending, Assigned, Out for Delivery, Delivered
  productId      Int?
  product        Product?  @relation(fields: [productId], references: [id])
}

model MilkSubscription {
  id                 Int           @id @default(autoincrement())
  userId             Int?
  adminId            Int
  customerName       String
  phone              String
  address            String
  pincode            String?
  milkType           String
  dailyQuantity      Float
  requestedStartDate DateTime
  requestedEndDate   DateTime
  offeredStartDate   DateTime?
  offeredEndDate     DateTime?
  finalStartDate     DateTime?
  finalEndDate       DateTime?
  pricePerLitre      Float?
  totalDays          Int?
  totalAmount        Float?
  status             String        @default("PENDING_ADMIN") // PENDING_ADMIN, ADMIN_OFFERED, AWAITING_CUSTOMER, AWAITING_PAYMENT, ACTIVE, REJECTED, CANCELLED, COMPLETED
  paymentMethod      String? // "Online", "Cash"
  paymentStatus      String        @default("PAYMENT_PENDING") // PAYMENT_PENDING, PAYMENT_PROCESSING, PAID, CASH_PENDING, FAILED, REFUNDED
  notes              String?
  createdAt          DateTime      @default(now())
  admin              Admin         @relation(fields: [adminId], references: [id])
  payments           MilkPayment[]
  deliveryBoyId      Int?
  deliveryStatus     String?       @default("Pending") // Pending, Assigned, Out for Delivery, Delivered
  productId          Int?
  product            Product?      @relation(fields: [productId], references: [id])
  deliveryRequests   MilkDeliveryRequest[]
}

model MilkPayment {
  id             Int              @id @default(autoincrement())
  subscriptionId Int
  amount         Float
  paymentMethod  String
  paymentStatus  String
  transactionId  String?
  verifiedAt     DateTime?
  createdAt      DateTime         @default(now())
  subscription   MilkSubscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
}

// ========================
// Smart Delivery Boy System
// ========================

model DeliveryBoyProfile {
  id             Int      @id @default(autoincrement())
  adminId        Int      @unique
  admin          Admin    @relation(fields: [adminId], references: [id], onDelete: Cascade)
  mobile         String?
  pincodes       String[]
  latitude       Float?
  longitude      Float?
  deliveryRadius Float?   @default(10)
  accountStatus  String   @default("Active")
  dailyStatus    String   @default("Available")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model DeliveryAvailability {
  id            Int      @id @default(autoincrement())
  deliveryBoyId Int
  deliveryBoy   Admin    @relation(fields: [deliveryBoyId], references: [id], onDelete: Cascade)
  date          DateTime
  status        String
  createdAt     DateTime @default(now())

  @@unique([deliveryBoyId, date])
}

model DeliveryAssignment {
  id             Int      @id @default(autoincrement())
  orderType      String
  orderId        Int
  deliveryBoyId  Int
  deliveryBoy    Admin    @relation(fields: [deliveryBoyId], references: [id])
  assignedById   Int
  deliveryDate   DateTime @default(now())
  deliveryStatus String   @default("Assigned")
  
  // Security Fields
  qrCode         String?  @unique
  deliveryOtp    String?  
  isQrScanned    Boolean  @default(false)
  isOtpVerified  Boolean  @default(false)
  deliveryProof  String?
  qrScannedAt    DateTime?
  userConfirmedAt DateTime?
  deliveredAt    DateTime?
  selectedItems   Json?
  confirmationIssue String?

  notes          String?
  isActive       Boolean  @default(true)
  previousDeliveryBoyId Int?
  needsReassignment     Boolean  @default(false)
  reassignmentReason    String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model UserAlert {
  id             Int       @id @default(autoincrement())
  userId         Int
  user           Admin     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title          String?
  message        String
  type           String    @default("GENERAL")
  role           String?
  orderType      String?
  orderId        Int?
  entityType     String?
  entityId       Int?
  deliveryId     Int?
  priority       String    @default("NORMAL")
  isSpecialAlert Boolean   @default(false)
  isDismissed    Boolean   @default(false)
  actionType     String?
  actionUrl      String?
  metadata       Json?
  isRead         Boolean   @default(false)
  readAt         DateTime?
  dismissedAt    DateTime?
  createdAt      DateTime  @default(now())

  @@index([userId, isRead])
  @@index([userId, isSpecialAlert, isDismissed])
}

model DeliveryHistory {
  id                 Int      @id @default(autoincrement())
  orderType          String
  orderId            Int
  userId             Int?
  user               Admin?   @relation(fields: [userId], references: [id], onDelete: SetNull)
  deliveryBoyId      Int?
  qrToken            String?
  qrScannedAt        DateTime?
  itemsSelected      Json?
  userConfirmationAt DateTime?
  deliveredAt        DateTime?
  status             String
  action             String
  metadata           Json?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

model DeliveryBoyLeave {
  id              Int       @id @default(autoincrement())
  deliveryBoyId   Int
  deliveryBoy     Admin     @relation(name: "DeliveryBoyLeaves", fields: [deliveryBoyId], references: [id], onDelete: Cascade)
  startDate       DateTime
  endDate         DateTime
  reason          String
  status          String    @default("PENDING") // PENDING, APPROVED, REJECTED, CANCELLED
  appliedAt       DateTime  @default(now())
  approvedById    Int?
  approvedBy      Admin?    @relation(name: "AdminApprovedLeaves", fields: [approvedById], references: [id], onDelete: SetNull)
  approvedAt      DateTime?
  rejectionReason String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([deliveryBoyId, status])
  @@index([startDate, endDate])
}

model MilkDeliveryRequest {
  id              Int               @id @default(autoincrement())
  customerId      Int
  customer        Admin             @relation(name: "CustomerDeliveryRequests", fields: [customerId], references: [id], onDelete: Cascade)
  subscriptionId  Int?
  subscription    MilkSubscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)
  deliveryDate    DateTime
  requestType     String            // EXTRA_MILK, SKIP_DELIVERY
  regularQuantity Float             @default(0)
  extraQuantity   Float             @default(0)
  totalQuantity   Float             @default(0)
  note            String?
  status          String            @default("PENDING") // PENDING, APPROVED, REJECTED, CANCELLED
  approvedById    Int?
  approvedBy      Admin?            @relation(name: "AdminApprovedRequests", fields: [approvedById], references: [id], onDelete: SetNull)
  approvedAt      DateTime?
  rejectedReason  String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  @@index([customerId, deliveryDate])
  @@index([status, deliveryDate])
}
