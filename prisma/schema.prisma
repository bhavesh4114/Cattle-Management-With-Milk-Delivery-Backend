generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  CUSTOM
}

model CustomRole {
  id          Int      @id @default(autoincrement())
  name        String   @unique
  status      String   @default("Active")
  permissions String[]
  admins      Admin[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Admin {
  id           Int         @id @default(autoincrement())
  name         String
  email        String      @unique
  password     String
  role         Role        @default(ADMIN)
  status       String      @default("Active")
  customRoleId Int?
  customRole   CustomRole? @relation(fields: [customRoleId], references: [id])
  doorQrToken  String?     @unique
  isQrEnabled  Boolean     @default(true)
  createdAt    DateTime    @default(now())

  // Multi-tenant relations
  cows                 Cow[]
  reproductionRecords  ReproductionRecord[]
  foodPurchases        FoodPurchase[]
  cowFoodRecords       CowFoodRecord[]
  foodIntakes          FoodIntake[]
  milkRecords          MilkRecord[]
  cowSales             CowSale[]
  treatments           Treatment[]
  items                Item[]
  stockAdjustments     StockAdjustment[]
  orders               Order[]
  cowDeaths            CowDeath[]
  animalFeedingPlans   AnimalFeedingPlan[]
  milkAllocations      MilkAllocation[]
  customerMilkOrders   CustomerMilkOrder[]
  products             Product[]
  milkTrials           MilkTrial[]
  milkSubscriptions    MilkSubscription[]
  conversionRules      ConversionRule[]
  deliveryProfile      DeliveryBoyProfile?
  deliveryAssignments  DeliveryAssignment[]
  deliveryHistories     DeliveryHistory[]
  deliveryAvailability DeliveryAvailability[]
  userAlerts           UserAlert[]
  deliveryBoyLeaves    DeliveryBoyLeave[]     @relation("DeliveryBoyLeaves")
  approvedLeaves       DeliveryBoyLeave[]     @relation("AdminApprovedLeaves")
  deliveryRequests        MilkDeliveryRequest[]  @relation("CustomerDeliveryRequests")
  approvedDeliveryRequests MilkDeliveryRequest[] @relation("AdminApprovedRequests")
  customerFeedbacks      OrderFeedback[]        @relation("CustomerFeedbacks")
  deliveryFeedbacks      OrderFeedback[]        @relation("DeliveryBoyFeedbacks")
  customerComplaints     CustomerComplaint[]    @relation("CustomerComplaints")
  deliveryComplaints     CustomerComplaint[]    @relation("DeliveryBoyComplaints")
  assignedComplaints     CustomerComplaint[]    @relation("AssignedStaffComplaints")
  changedComplaintHistories ComplaintStatusHistory[] @relation("ComplaintHistoryChangedBy")
  participantConversations ChatConversation[]     @relation("ParticipantConversations")
  adminConversations       ChatConversation[]     @relation("AdminConversations")
  sentChatMessages         ChatMessage[]          @relation("SentChatMessages")

  // Referral & Coupon relations
  referralCode             String?                @unique
  referredById             Int?
  referredBy               Admin?                 @relation("AdminReferrals", fields: [referredById], references: [id])
  referredUsers            Admin[]                @relation("AdminReferrals")
  referralsGiven           Referral[]             @relation("Referrer")
  referralsReceived        Referral?              @relation("Referee")
  assignedCoupons          UserCoupon[]
}

model ConversionRule {
  id            Int      @id @default(autoincrement())
  inputMaterial String   @default("Milk") // e.g. Milk, Curd, Cream
  inputQty      Float
  outputProduct String // e.g. Ghee, Paneer, Curd
  outputQty     Float
  outputUnit    String // e.g. L, KG
  isActive      Boolean  @default(true)
  adminId       Int?
  admin         Admin?   @relation(fields: [adminId], references: [id])
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Cow {
  id                  Int                  @id @default(autoincrement())
  tagNo               String
  name                String
  breed               String
  age                 Int
  gender              String
  status              String               @default("Active")
  animalType          String               @default("Cow")
  regNo               String?
  dob                 DateTime?
  purchaseDate        DateTime?
  purchaseFrom        String?
  purchaseAddress     String?
  mobileNo            String?
  purchasePrice       Float?
  governmentTagNo     String?
  fatherName          String?
  motherName          String?
  fatherFatherName    String?
  fatherMotherName    String?
  motherFatherName    String?
  motherMotherName    String?
  image               String?
  image2              String?
  isActiveForMilk     Boolean              @default(false)
  createdAt           DateTime             @default(now())
  milk                MilkRecord[]
  food                CowFoodRecord[]
  treatments          Treatment[]
  sales               CowSale[]
  deaths              CowDeath[]
  reproductionRecords ReproductionRecord[]
  feedingPlans        AnimalFeedingPlan[]
  foodIntakes         FoodIntake[]
  adminId             Int?
  admin               Admin?               @relation(fields: [adminId], references: [id])

  @@unique([adminId, tagNo])
}

model ReproductionRecord {
  id                   Int       @id @default(autoincrement())
  cowId                Int
  heatDate             DateTime?
  aiDate               DateTime?
  aiBullName           String?
  bullName             String?
  doctorName           String?
  doctorArrivingAt     DateTime?
  pregnancyCheckDate   DateTime?
  pregnancyStatus      String?
  deliveryDate         DateTime?
  calfName             String?
  remark               String?
  breedingStatus       String?
  lastBreedingDate     DateTime?
  serviceCount         Int?
  aiType               String?
  expectedNextHeatDate DateTime?
  pregnancyMonth       String?
  veterinaryRemarks    String?
  createdAt            DateTime  @default(now())
  cow                  Cow       @relation(fields: [cowId], references: [id], onDelete: Cascade)
  adminId              Int?
  admin                Admin?    @relation(fields: [adminId], references: [id])
}

model FoodPurchase {
  id          Int      @id @default(autoincrement())
  itemName    String
  quantityKg  Float
  price       Float
  supplier    String?
  purchasedAt DateTime @default(now())
  adminId     Int?
  admin       Admin?   @relation(fields: [adminId], references: [id])
}

model CowFoodRecord {
  id         Int      @id @default(autoincrement())
  cowId      Int
  foodType   String
  quantityKg Float
  fedAt      DateTime @default(now())
  cow        Cow      @relation(fields: [cowId], references: [id], onDelete: Cascade)
  adminId    Int?
  admin      Admin?   @relation(fields: [adminId], references: [id])
}

model FoodIntake {
  id              Int      @id @default(autoincrement())
  cowId           Int?
  foodItem        String?
  foodType        String
  morningIntake   Float?   @default(0)
  afternoonIntake Float?   @default(0)
  eveningIntake   Float?   @default(0)
  totalIntake     Float    @default(0)
  quantityKg      Float?
  notes           String?
  recordedAt      DateTime @default(now())
  cow             Cow?     @relation(fields: [cowId], references: [id], onDelete: Cascade)
  adminId         Int?
  admin           Admin?   @relation(fields: [adminId], references: [id])
}

model MilkRecord {
  id          Int      @id @default(autoincrement())
  cowId       Int
  morningMilk Float?
  eveningMilk Float?
  totalMilk   Float    @default(0)
  recordDate  DateTime @default(now())
  cow         Cow      @relation(fields: [cowId], references: [id], onDelete: Cascade)
  adminId     Int?
  admin       Admin?   @relation(fields: [adminId], references: [id])
}

model CowSale {
  id             Int      @id @default(autoincrement())
  cowId          Int
  buyer          String
  amount         Float
  soldAt         DateTime @default(now())
  paymentMethod  String   @default("Cash")
  paymentStatus  String   @default("Paid")
  amountReceived Float    @default(0)
  buyerPhone     String?
  buyerAddress   String?
  buyerCity      String?
  buyerState     String?
  buyerPincode   String?
  reason         String   @default("Other")
  otherReason    String?
  lastMilkProd   Float?
  lastFeedIntake Float?
  remark         String?
  cow            Cow      @relation(fields: [cowId], references: [id], onDelete: Cascade)
  adminId        Int?
  admin          Admin?   @relation(fields: [adminId], references: [id])
}

model Treatment {
  id             Int      @id @default(autoincrement())
  cowId          Int
  diagnosis      String
  medicine       String
  cost           Float
  treatedAt      DateTime @default(now())
  doctorName     String?
  remarks        String?
  milkDropSource Boolean  @default(false)
  previousMilk   Float?
  currentMilk    Float?
  dropPercentage Float?
  cow            Cow      @relation(fields: [cowId], references: [id], onDelete: Cascade)
  adminId        Int?
  admin          Admin?   @relation(fields: [adminId], references: [id])
}

model Item {
  id           Int               @id @default(autoincrement())
  name         String
  unit         String
  price        Float?
  currentStock Float             @default(0)
  minimumLevel Float?
  remarks      String?
  createdAt    DateTime          @default(now())
  adjustments  StockAdjustment[]
  adminId      Int?
  admin        Admin?            @relation(fields: [adminId], references: [id])
}

model StockAdjustment {
  id            Int      @id @default(autoincrement())
  itemId        Int
  type          String // "Add" or "Remove"
  previousStock Float
  adjustment    Float
  newStock      Float
  reason        String
  remarks       String?
  createdBy     String   @default("admin")
  createdAt     DateTime @default(now())
  item          Item     @relation(fields: [itemId], references: [id], onDelete: Cascade)
  adminId       Int?
  admin         Admin?   @relation(fields: [adminId], references: [id])
}

model Order {
  id            Int         @id @default(autoincrement())
  orderNumber   String      @unique
  vendorName    String
  location      String?
  purchaseDate  DateTime    @default(now())
  totalAmount   Float       @default(0)
  paymentStatus String      @default("Pending")
  remarks       String?
  createdAt     DateTime    @default(now())
  items         OrderItem[]
  adminId       Int?
  admin         Admin?      @relation(fields: [adminId], references: [id])
}

model OrderItem {
  id       Int    @id @default(autoincrement())
  orderId  Int
  itemName String
  quantity Float
  unit     String @default("Kg")
  price    Float
  order    Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

model CowDeath {
  id             Int       @id @default(autoincrement())
  cowId          Int
  reason         String
  deathAt        DateTime  @default(now())
  notes          String?
  disposalMethod String?
  disposalDate   DateTime?
  disposalCost   Float?
  cow            Cow       @relation(fields: [cowId], references: [id], onDelete: Cascade)
  adminId        Int?
  admin          Admin?    @relation(fields: [adminId], references: [id])
}

model AnimalFeedingPlan {
  id                 Int      @id @default(autoincrement())
  cowId              Int
  planName           String
  startDate          DateTime
  endDate            DateTime
  feedName           String
  feedType           String
  quantity           Float
  unit               String
  feedingTime        String
  frequency          String
  instructions       String?
  remarks            String?
  status             String   @default("Active")
  prevDayMilkProd    Float?
  recommendedFeedQty Float?
  createdAt          DateTime @default(now())
  basedOnMilk        Float?
  entryType          String?
  milkEntryId        Int?
  cow                Cow      @relation(fields: [cowId], references: [id], onDelete: Cascade)
  adminId            Int?
  admin              Admin?   @relation(fields: [adminId], references: [id])
}

model MilkAllocation {
  id           Int      @id @default(autoincrement())
  adminId      Int
  staffId      Int
  date         DateTime
  allocatedQty Float
  status       String   @default("Pending")
  createdAt    DateTime @default(now())
  admin        Admin    @relation(fields: [adminId], references: [id])
}

model StaffMilkReport {
  id           Int      @id @default(autoincrement())
  staffId      Int
  reportDate   DateTime
  receivedQty  Float
  totalUsedQty Float    @default(0)
  remainingQty Float    @default(0)
  usageDetails Json?
  status       String   @default("PENDING_ADMIN_REVIEW")
  adminRemarks String?
  createdAt    DateTime @default(now())
}

model CustomerMilkOrder {
  id               Int                @id @default(autoincrement())
  userId           Int?
  adminId          Int?
  customerName     String?
  phone            String
  address          String
  milkType         String
  quantity         Float
  deliveryDate     DateTime
  originalDate     DateTime?
  proposedDate     DateTime?
  deliveryBoyName  String?
  deliveryBoyPhone String?
  status           String             @default("PENDING_ADMIN")
  notes            String?
  createdAt        DateTime           @default(now())
  admin            Admin?             @relation(fields: [adminId], references: [id])
  history          OrderHistoryLine[]
  productId        Int?
  product          Product?           @relation(fields: [productId], references: [id])
}

model OrderHistoryLine {
  id            Int               @id @default(autoincrement())
  orderId       Int
  status        String
  actor         String
  actorName     String?
  actionDetails String?
  createdAt     DateTime          @default(now())
  order         CustomerMilkOrder @relation(fields: [orderId], references: [id])
}

// --- Milk Delivery System Models ---

model Product {
  id            Int                 @id @default(autoincrement())
  adminId       Int
  name          String
  image         String?
  price         Float
  description   String?
  size          String?
  unit          String?
  isActive      Boolean             @default(true)
  createdAt     DateTime            @default(now())
  admin         Admin               @relation(fields: [adminId], references: [id])
  orders        CustomerMilkOrder[]
  trials        MilkTrial[]
  subscriptions MilkSubscription[]
}

model MilkTrial {
  id             Int       @id @default(autoincrement())
  userId         Int?
  adminId        Int
  customerName   String
  phone          String
  address        String
  pincode        String?
  milkType       String
  dailyQuantity  Float
  startDate      DateTime?
  endDate        DateTime?
  status         String    @default("PENDING_ADMIN") // PENDING_ADMIN, ACTIVE, REJECTED, COMPLETED
  notes          String?
  createdAt      DateTime  @default(now())
  admin          Admin     @relation(fields: [adminId], references: [id])
  deliveryBoyId  Int?
  deliveryStatus String?   @default("Pending") // Pending, Assigned, Out for Delivery, Delivered
  productId      Int?
  product        Product?  @relation(fields: [productId], references: [id])
}

model MilkSubscription {
  id                 Int           @id @default(autoincrement())
  userId             Int?
  adminId            Int
  customerName       String
  phone              String
  address            String
  pincode            String?
  milkType           String
  dailyQuantity      Float
  requestedStartDate DateTime
  requestedEndDate   DateTime
  offeredStartDate   DateTime?
  offeredEndDate     DateTime?
  finalStartDate     DateTime?
  finalEndDate       DateTime?
  pricePerLitre      Float?
  totalDays          Int?
  totalAmount        Float?
  status             String        @default("PENDING_ADMIN") // PENDING_ADMIN, ADMIN_OFFERED, AWAITING_CUSTOMER, AWAITING_PAYMENT, ACTIVE, REJECTED, CANCELLED, COMPLETED
  paymentMethod      String? // "Online", "Cash"
  paymentStatus      String        @default("PAYMENT_PENDING") // PAYMENT_PENDING, PAYMENT_PROCESSING, PAID, CASH_PENDING, FAILED, REFUNDED
  notes              String?
  createdAt          DateTime      @default(now())
  admin              Admin         @relation(fields: [adminId], references: [id])
  payments           MilkPayment[]
  deliveryBoyId      Int?
  deliveryStatus     String?       @default("Pending") // Pending, Assigned, Out for Delivery, Delivered
  productId          Int?
  product            Product?      @relation(fields: [productId], references: [id])
  deliveryRequests   MilkDeliveryRequest[]
}

model MilkPayment {
  id             Int              @id @default(autoincrement())
  subscriptionId Int
  amount         Float
  paymentMethod  String
  paymentStatus  String
  transactionId  String?
  verifiedAt     DateTime?
  createdAt      DateTime         @default(now())
  subscription   MilkSubscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
}

// ========================
// Smart Delivery Boy System
// ========================

model DeliveryBoyProfile {
  id             Int      @id @default(autoincrement())
  adminId        Int      @unique
  admin          Admin    @relation(fields: [adminId], references: [id], onDelete: Cascade)
  mobile         String?
  pincodes       String[]
  latitude       Float?
  longitude      Float?
  deliveryRadius Float?   @default(10)
  accountStatus  String   @default("Active")
  dailyStatus    String   @default("Available")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model DeliveryAvailability {
  id            Int      @id @default(autoincrement())
  deliveryBoyId Int
  deliveryBoy   Admin    @relation(fields: [deliveryBoyId], references: [id], onDelete: Cascade)
  date          DateTime
  status        String
  createdAt     DateTime @default(now())

  @@unique([deliveryBoyId, date])
}

model DeliveryAssignment {
  id             Int      @id @default(autoincrement())
  orderType      String
  orderId        Int
  deliveryBoyId  Int
  deliveryBoy    Admin    @relation(fields: [deliveryBoyId], references: [id])
  assignedById   Int
  deliveryDate   DateTime @default(now())
  deliveryStatus String   @default("Assigned")
  
  // Security Fields
  qrCode         String?  @unique
  deliveryOtp    String?  
  isQrScanned    Boolean  @default(false)
  isOtpVerified  Boolean  @default(false)
  deliveryProof  String?
  qrScannedAt    DateTime?
  userConfirmedAt DateTime?
  deliveredAt    DateTime?
  selectedItems   Json?
  confirmationIssue String?

  notes          String?
  isActive       Boolean  @default(true)
  previousDeliveryBoyId Int?
  needsReassignment     Boolean  @default(false)
  reassignmentReason    String?

  // Lifecycle Timestamps
  assignedAt           DateTime? @default(now())
  productCollectedAt   DateTime?
  outForDeliveryAt     DateTime?
  deliveryStartTime    DateTime?
  estimatedDeliveryTime DateTime?
  arrivedAt            DateTime?
  deliveryConfirmedAt  DateTime?
  customerConfirmedAt  DateTime?
  deliveryCompletedAt  DateTime?
  delayAlertSentAt     DateTime?

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model UserAlert {
  id             Int       @id @default(autoincrement())
  userId         Int
  user           Admin     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title          String?
  message        String
  type           String    @default("GENERAL")
  role           String?
  orderType      String?
  orderId        Int?
  entityType     String?
  entityId       Int?
  deliveryId     Int?
  priority       String    @default("NORMAL")
  isSpecialAlert Boolean   @default(false)
  isDismissed    Boolean   @default(false)
  actionType     String?
  actionUrl      String?
  metadata       Json?
  isRead         Boolean   @default(false)
  readAt         DateTime?
  dismissedAt    DateTime?
  createdAt      DateTime  @default(now())

  @@index([userId, isRead])
  @@index([userId, isSpecialAlert, isDismissed])
}

model DeliveryHistory {
  id                 Int      @id @default(autoincrement())
  orderType          String
  orderId            Int
  userId             Int?
  user               Admin?   @relation(fields: [userId], references: [id], onDelete: SetNull)
  deliveryBoyId      Int?
  qrToken            String?
  qrScannedAt        DateTime?
  itemsSelected      Json?
  userConfirmationAt DateTime?
  deliveredAt        DateTime?
  status             String
  action             String
  metadata           Json?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

model DeliveryBoyLeave {
  id              Int       @id @default(autoincrement())
  deliveryBoyId   Int
  deliveryBoy     Admin     @relation(name: "DeliveryBoyLeaves", fields: [deliveryBoyId], references: [id], onDelete: Cascade)
  startDate       DateTime
  endDate         DateTime
  reason          String
  status          String    @default("PENDING") // PENDING, APPROVED, REJECTED, CANCELLED
  appliedAt       DateTime  @default(now())
  approvedById    Int?
  approvedBy      Admin?    @relation(name: "AdminApprovedLeaves", fields: [approvedById], references: [id], onDelete: SetNull)
  approvedAt      DateTime?
  rejectionReason String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([deliveryBoyId, status])
  @@index([startDate, endDate])
}

model MilkDeliveryRequest {
  id                    Int               @id @default(autoincrement())
  customerId            Int
  customer              Admin             @relation(name: "CustomerDeliveryRequests", fields: [customerId], references: [id], onDelete: Cascade)
  subscriptionId        Int?
  subscription          MilkSubscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)
  deliveryDate          DateTime
  requestType           String            // EXTRA_MILK, SKIP_DELIVERY
  regularQuantity       Float             @default(0)
  extraQuantity         Float             @default(0)
  totalQuantity         Float             @default(0)
  note                  String?
  status                String            @default("EXTRA_REQUESTED") // EXTRA_REQUESTED, ADMIN_OFFERED, CUSTOMER_ACCEPTED, EXTRA_REQUEST_REJECTED, EXTRA_ASSIGNED, DELIVERED, PENDING, APPROVED, REJECTED, CANCELLED
  availableQuantity     Float?
  offeredQuantity       Float?
  acceptedQuantity      Float?
  assignedDeliveryBoyId Int?
  deliveryStatus        String?
  assignmentId          Int?
  approvedById          Int?
  approvedBy            Admin?            @relation(name: "AdminApprovedRequests", fields: [approvedById], references: [id], onDelete: SetNull)
  approvedAt            DateTime?
  rejectedReason        String?
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt

  @@index([customerId, deliveryDate])
  @@index([status, deliveryDate])
}

// ======================================
// Feedback & Complaint Management Models
// ======================================

model OrderFeedback {
  id                   Int      @id @default(autoincrement())
  orderType            String   // 'trial' | 'subscription'
  orderId              Int      // id of MilkTrial or MilkSubscription
  customerId           Int
  customer             Admin    @relation("CustomerFeedbacks", fields: [customerId], references: [id], onDelete: Cascade)
  deliveryBoyId        Int?
  deliveryBoy          Admin?   @relation("DeliveryBoyFeedbacks", fields: [deliveryBoyId], references: [id], onDelete: SetNull)
  rating               Int      // 1 to 5 overall rating
  deliveryBoyRating    Int?     // 1 to 5 delivery boy rating
  productQualityRating Int?     // 1 to 5 product quality rating
  review               String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@unique([orderType, orderId])
  @@index([customerId])
  @@index([deliveryBoyId])
  @@index([rating])
}

model CustomerComplaint {
  id              Int                      @id @default(autoincrement())
  complaintCode   String                   @unique // e.g. CMP-20261011-1234
  orderType       String                   // 'trial' | 'subscription'
  orderId         Int
  customerId      Int
  customer        Admin                    @relation("CustomerComplaints", fields: [customerId], references: [id], onDelete: Cascade)
  deliveryBoyId   Int?
  deliveryBoy     Admin?                   @relation("DeliveryBoyComplaints", fields: [deliveryBoyId], references: [id], onDelete: SetNull)
  assignedStaffId Int?
  assignedStaff   Admin?                   @relation("AssignedStaffComplaints", fields: [assignedStaffId], references: [id], onDelete: SetNull)
  category        String                   // Late or incomplete delivery, Wrong milk quantity, Product quality, Missing product, Delivery boy behaviour, Payment issue, Other
  description     String
  attachment      String?                  // file path / URL
  status          String                   @default("PENDING") // PENDING, IN_PROGRESS, RESOLVED, REOPENED
  adminNotes      String?
  resolutionNotes String?
  resolvedAt      DateTime?
  reopenedAt      DateTime?
  reopenReason    String?
  createdAt       DateTime                 @default(now())
  updatedAt       DateTime                 @updatedAt
  history         ComplaintStatusHistory[]

  @@index([customerId])
  @@index([status])
  @@index([orderType, orderId])
}

model ComplaintStatusHistory {
  id          Int               @id @default(autoincrement())
  complaintId Int
  complaint   CustomerComplaint @relation(fields: [complaintId], references: [id], onDelete: Cascade)
  status      String            // PENDING, IN_PROGRESS, RESOLVED, REOPENED
  actionBy    String            // "Customer" | "Admin" | "Staff"
  changedById Int?
  changedBy   Admin?            @relation("ComplaintHistoryChangedBy", fields: [changedById], references: [id], onDelete: SetNull)
  notes       String?
  createdAt   DateTime          @default(now())

  @@index([complaintId])
}

model ChatConversation {
  id              Int           @id @default(autoincrement())
  participantId   Int
  participant     Admin         @relation("ParticipantConversations", fields: [participantId], references: [id], onDelete: Cascade)
  participantRole String        // "USER" | "DELIVERY_BOY"
  adminId         Int?
  admin           Admin?        @relation("AdminConversations", fields: [adminId], references: [id], onDelete: SetNull)
  lastMessageAt   DateTime      @default(now())
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  messages        ChatMessage[]

  @@unique([participantId, participantRole])
  @@index([participantRole])
  @@index([lastMessageAt])
}

model ChatMessage {
  id             Int              @id @default(autoincrement())
  conversationId Int
  conversation   ChatConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId       Int
  sender         Admin            @relation("SentChatMessages", fields: [senderId], references: [id], onDelete: Cascade)
  senderRole     String           // "ADMIN" | "USER" | "DELIVERY_BOY"
  messageText    String           @db.Text
  deliveredAt    DateTime?
  readAt         DateTime?
  createdAt      DateTime         @default(now())

  @@index([conversationId])
  @@index([senderId])
  @@index([createdAt])
}

model DeliveryProof {
  id              Int       @id @default(autoincrement())
  orderType       String    // "sub" | "trial" | "extra"
  orderId         Int
  assignmentId    Int?
  customerId      Int?
  customerName    String?
  deliveryBoyId   Int
  deliveryBoyName String?
  productId       Int?
  productName     String?
  itemLabel       String?
  quantity        Float?
  unit            String?
  photoUrl        String
  qrToken         String?
  status          String    @default("VERIFIED") // "CAPTURED", "AWAITING_CONFIRMATION", "VERIFIED"
  capturedAt      DateTime  @default(now())
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([orderType, orderId])
  @@index([assignmentId])
  @@index([deliveryBoyId])
  @@index([customerId])
}

// ─── Referral and Coupon Reward Models ─────────────────────────────

model Coupon {
  id                 Int               @id @default(autoincrement())
  code               String            @unique
  description        String?
  discountType       String            // "PERCENTAGE" | "FLAT"
  value              Float
  minOrderAmount     Float?            @default(0)
  maxDiscount        Float?
  validUntil         DateTime?
  status             String            @default("ACTIVE") // "ACTIVE" | "EXPIRED" | "DISABLED"
  targetProductName  String?
  usageLimit         Int?
  redemptionsCount   Int               @default(0)
  isReferralReward   Boolean           @default(false)
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  userCoupons        UserCoupon[]
  referrerSettings   ReferralSetting[] @relation("ReferrerCoupon")
  refereeSettings    ReferralSetting[] @relation("RefereeCoupon")

  @@index([status])
  @@index([code])
}

model UserCoupon {
  id          Int       @id @default(autoincrement())
  userId      Int
  user        Admin     @relation(fields: [userId], references: [id], onDelete: Cascade)
  couponId    Int
  coupon      Coupon    @relation(fields: [couponId], references: [id], onDelete: Cascade)
  status      String    @default("ACTIVE") // "ACTIVE" | "REDEEMED" | "EXPIRED"
  source      String    @default("REFERRAL") // "REFERRAL" | "PROMOTION" | "SIGNUP"
  assignedAt  DateTime  @default(now())
  redeemedAt  DateTime?
  orderId     Int?

  @@index([userId, status])
  @@index([couponId])
}

model ReferralSetting {
  id                 Int       @id @default(autoincrement())
  isEnabled          Boolean   @default(true)
  rewardTarget       String    @default("BOTH") // "BOTH" | "REFERRER" | "REFEREE"
  referrerCouponId   Int?
  referrerCoupon     Coupon?   @relation("ReferrerCoupon", fields: [referrerCouponId], references: [id], onDelete: SetNull)
  refereeCouponId    Int?
  refereeCoupon      Coupon?   @relation("RefereeCoupon", fields: [refereeCouponId], references: [id], onDelete: SetNull)
  updatedAt          DateTime  @updatedAt
}

model Referral {
  id                   Int       @id @default(autoincrement())
  referrerId           Int
  referrer             Admin     @relation("Referrer", fields: [referrerId], references: [id], onDelete: Cascade)
  refereeId            Int       @unique
  referee              Admin     @relation("Referee", fields: [refereeId], references: [id], onDelete: Cascade)
  status               String    @default("COMPLETED") // "COMPLETED" | "NO_REWARD"
  referrerRewardStatus String    @default("NONE") // "AWARDED" | "NONE"
  refereeRewardStatus  String    @default("NONE") // "AWARDED" | "NONE"
  referrerCouponCode   String?
  refereeCouponCode    String?
  createdAt            DateTime  @default(now())

  @@index([referrerId])
  @@index([refereeId])
}

